# Query: 
# ContextLines: 1

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NDDU SHS Research Journal Repository</title>
    <!-- Tailwind CSS for Styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        ndduGreen: '#166534', // Deeper, more formal institutional green
                        ndduAccent: '#C29B40', // Refined gold color from typical university branding
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 font-sans text-slate-800 min-h-screen flex flex-col">

    <!-- IMAGE HEADER SECTION -->
    <header class="w-full relative shadow-lg">
        <img src="header.png" alt="Notre Dame of Dadiangas University - Main Building" 
             class="w-full h-[300px] object-cover object-center filter brightness-90">
        
        <!-- Text Overlay (Optional: If the image already has the clear title, you could remove this overlay) -->
        <div class="absolute inset-0 bg-ndduGreen/70 flex items-center justify-center">
            <div class="text-center px-4">
                <h1 class="text-3xl md:text-4xl font-serif font-bold text-white tracking-wide">NOTRE DAME OF DADIANGAS UNIVERSITY</h1>
                <p class="text-lg text-amber-200 tracking-wider font-semibold">SENIOR HIGH SCHOOL RESEARCH JOURNAL REPOSITORY</p>
                <div class="w-24 h-1 bg-ndduAccent mx-auto mt-3"></div>
            </div>
        </div>
    </header>

    <!-- SUB-HEADER BAR -->
    <div class="bg-slate-900 text-slate-300 py-3 border-t-2 border-ndduAccent">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-xs tracking-wide">
            IBED Lagao Campus | Academic Research Office | "Character Excellence, Service Excellence"
        </div>
    </div>

    <!-- MAIN CONTAINER -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow w-full">

        <!-- SEARCH AND FILTER SECTION -->
        <section class="bg-white p-6 rounded-lg shadow-sm border border-slate-100 mb-8">
            <div class="flex flex-col md:flex-row gap-4 justify-between items-center mb-6">
                <!-- Search Input -->
                <div class="relative w-full md:w-1/2">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="searchInput" placeholder="Search by title, author, or keyword..." 
                           class="w-full pl-10 pr-4 py-2.5 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-ndduGreen">
                </div>

                <!-- Academic Strand Filters -->
                <div class="flex flex-wrap gap-2 w-full md:w-auto justify-start md:justify-end" id="strandFilters">
                    <button onclick="filterStrand('ALL')" class="filter-btn active bg-ndduGreen text-white px-3 py-1.5 rounded-md text-sm font-medium transition">All Papers</button>
                    <button onclick="filterStrand('STEM')" class="filter-btn bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-md text-sm font-medium transition">STEM</button>
                    <button onclick="filterStrand('ABM')" class="filter-btn bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-md text-sm font-medium transition">ABM</button>
                    <button onclick="filterStrand('HUMSS')" class="filter-btn bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-md text-sm font-medium transition">HUMSS</button>
                    <button onclick="filterStrand('GAS')" class="filter-btn bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-md text-sm font-medium transition">GAS</button>
                </div>
            </div>

            <!-- Stats Bar -->
            <div class="text-xs text-slate-500 border-t border-slate-100 pt-3 flex justify-between items-center">
                <span>Showing <strong id="paperCount" class="text-slate-800">0</strong> published research papers</span>
                <span>Sorted by: <strong>Latest First</strong></span>
            </div>
        </section>

        <!-- PAPERS CATALOG GRID -->
        <section id="papersGrid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Dynamic JS injection will happen here -->
        </section>

        <!-- EMPTY STATE -->
        <div id="noResults" class="hidden text-center py-12 bg-white rounded-lg border border-dashed border-slate-300">
            <i class="fa-solid fa-folder-open text-4xl text-slate-300 mb-3"></i>
            <h3 class="text-lg font-medium text-slate-600">No research papers found</h3>
            <p class="text-sm text-slate-400">Try adjusting your search terms or strand filter.</p>
        </div>
    </main>

    <!-- ABSTRACT MODAL POPUP -->
    <div id="abstractModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-[90vh] flex flex-col overflow-hidden">
            <div class="p-6 border-b border-slate-100 flex justify-between items-start bg-slate-50">
                <div>
                    <span id="modalStrand" class="text-xs font-semibold px-2.5 py-0.5 rounded text-white bg-ndduGreen">STRAND</span>
                    <h3 id="modalTitle" class="text-lg font-serif font-bold text-slate-800 mt-2">Title</h3>
                    <p id="modalAuthors" class="text-xs text-slate-500 mt-1">Authors</p>
                </div>
                <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 p-1">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>
            <div class="p-6 overflow-y-auto flex-grow">
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Abstract</h4>
                <p id="modalAbstract" class="text-sm text-slate-600 leading-relaxed text-justify">Full abstract content goes here...</p>
                
                <div class="mt-6 pt-4 border-t border-slate-100 flex flex-wrap gap-4 text-xs text-slate-500">
                    <div><strong>Academic Year:</strong> <span id="modalYear"></span></div>
                    <div><strong>Adviser:</strong> <span id="modalAdviser"></span></div>
                </div>
            </div>
            <div class="p-4 border-t border-slate-100 bg-slate-50 flex justify-end gap-3">
                <button onclick="closeModal()" class="px-4 py-2 text-xs font-medium text-slate-600 hover:bg-slate-200 rounded">Close</button>
                <a id="modalDriveBtn" href="#" target="_blank" class="px-4 py-2 text-xs font-medium bg-ndduGreen text-white rounded hover:bg-emerald-800 flex items-center gap-2">
                    <i class="fa-solid fa-file-pdf"></i> View Full PDF Paper
                </a>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="bg-slate-900 text-slate-400 text-xs py-6 mt-12 border-t border-slate-700">
        <div class="max-w-7xl mx-auto px-4 text-center space-y-2">
            <p>© 2026 Notre Dame of Dadiangas University - Senior High School Department.</p>
            <p>For research inquiries, contact the SHS Academic Research Office at <a href="mailto:nddushs.1112@gmail.com" class="text-amber-400 hover:underline">nddushs.1112@gmail.com</a></p>
        </div>
    </footer>

    <!-- JAVASCRIPT LOGIC (Unchanged, just copied for a complete file) -->
    <script>
        // SAMPLE DATA REPOSITORY (Replace Google Drive URLs with your actual student links)
        const researchPapers = [
            {
                id: 1,
                title: "Feasibility of Green Tea Extract as a Natural Bio-Preservative for Fresh Produce",
                authors: "Dela Cruz, J., Santos, M., & Garcia, R.",
                strand: "STEM",
                year: "2025-2026",
                adviser: "Dr. A. Ramos, LPT",
                abstract: "This study investigates the antimicrobial properties of green tea extract in extending the shelf-life of leafy green vegetables commonly sold in local markets in General Santos City. Through experimental trials, leaf weight retention and microbial count were evaluated across 14 days...",
                driveUrl: "https://drive.google.com" 
            },
            {
                id: 2,
                title: "Digital Marketing Strategies and Consumer Behavior Among Micro-Entrepreneurs in GenSan",
                authors: "Alvarez, K., Tan, B., & Lim, C.",
                strand: "ABM",
                year: "2025-2026",
                adviser: "Prof. E. Morales, MBA",
                abstract: "Analyzing the adoption of digital payments and social media advertising among local micro-entrepreneurs. The research highlights a significant positive correlation between active social media engagement and monthly sales growth during post-pandemic recovery.",
                driveUrl: "https://drive.google.com"
            },
            {
                id: 3,
                title: "Preserving Local Indigenous Heritage: A Narrative Inquiry into Matigsalug Oral Traditions",
                authors: "Magbanua, P., & Fernandez, S.",
                strand: "HUMSS",
                year: "2024-2025",
                adviser: "Mr. J. Villaruel, MA",
                abstract: "Using qualitative narrative analysis, this paper documents oral literature, folk tales, and historical accounts from elders of indigenous communities in Region XII, aiming to construct contextualized educational materials for high school humanities instruction.",
                driveUrl: "https://drive.google.com"
            },
            {
                id: 4,
                title: "Comparative Study on Student Productivity Techniques Under Hybrid Learning Frameworks",
                authors: "Torres, H., Reyes, E., & Gonzales, A.",
                strand: "GAS",
                year: "2024-2025",
                adviser: "Ms. C. Aquino, MAEd",
                abstract: "This cross-sectional survey examines how Senior High School students balance self-paced modular learning with synchronous classroom lectures. Findings suggest structured time-blocking significantly reduces academic procrastination.",
                driveUrl: "https://drive.google.com"
            }
        ];

        let currentStrand = 'ALL';

        function renderPapers(data) {
            const grid = document.getElementById('papersGrid');
            const noResults = document.getElementById('noResults');
            document.getElementById('paperCount').innerText = data.length;

            grid.innerHTML = '';

            if (data.length === 0) {
                noResults.classList.remove('hidden');
                return;
            } else {
                noResults.classList.add('hidden');
            }

            data.forEach(paper => {
                const card = document.createElement('article');
                card.className = "bg-white p-6 rounded-lg border border-slate-100 shadow-sm hover:shadow-md transition flex flex-col justify-between";
                
                card.innerHTML = `
                    <div>
                        <div class="flex justify-between items-center mb-3">
                            <span class="text-xs font-bold px-2.5 py-1 rounded bg-slate-50 text-ndduGreen border border-emerald-100">${paper.strand} STRAND</span>
                            <span class="text-xs text-slate-400 font-mono"><i class="fa-regular fa-calendar me-1"></i>A.Y. ${paper.year}</span>
                        </div>
                        <h3 class="text-lg font-serif font-bold text-slate-800 hover:text-ndduGreen transition mb-2 cursor-pointer" onclick="openModal(${paper.id})">${paper.title}</h3>
                        <p class="text-xs font-medium text-slate-500 mb-3"><i class="fa-solid fa-user-pen me-1"></i>${paper.authors}</p>
                        <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed mb-4">${paper.abstract}</p>
                    </div>
                    
                    <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
                        <button onclick="openModal(${paper.id})" class="text-ndduGreen font-semibold hover:underline flex items-center gap-1">
                            Read Abstract <i class="fa-solid fa-arrow-right text-[10px]"></i>
                        </button>
                        <a href="${paper.driveUrl}" target="_blank" class="bg-slate-800 text-white px-3 py-1.5 rounded hover:bg-slate-700 transition flex items-center gap-1.5">
                            <i class="fa-solid fa-file-pdf text-red-400"></i> PDF Link
                        </a>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function filterPapers() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const filtered = researchPapers.filter(paper => {
                const matchesStrand = (currentStrand === 'ALL' || paper.strand === currentStrand);
                const matchesSearch = paper.title.toLowerCase().includes(searchTerm) || 
                                      paper.authors.toLowerCase().includes(searchTerm) ||
                                      paper.abstract.toLowerCase().includes(searchTerm);
                return matchesStrand && matchesSearch;
            });
            renderPapers(filtered);
        }

        function filterStrand(strand) {
            currentStrand = strand;
            const buttons = document.querySelectorAll('.filter-btn');
            buttons.forEach(btn => {
                if(btn.innerText.includes(strand) || (strand === 'ALL' && btn.innerText.includes('All'))) {
                    btn.className = "filter-btn active bg-ndduGreen text-white px-3 py-1.5 rounded-md text-sm font-medium transition";
                } else {
                    btn.className = "filter-btn bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-1.5 rounded-md text-sm font-medium transition";
                }
            });
            filterPapers();
        }

        function openModal(id) {
            const paper = researchPapers.find(p => p.id === id);
            if(!paper) return;
            document.getElementById('modalTitle').innerText = paper.title;
            document.getElementById('modalStrand').innerText = `${paper.strand} STRAND`;
            document.getElementById('modalAuthors').innerText = `Authors: ${paper.authors}`;
            document.getElementById('modalAbstract').innerText = paper.abstract;
            document.getElementById('modalYear').innerText = paper.year;
            document.getElementById('modalAdviser').innerText = paper.adviser;
            document.getElementById('modalDriveBtn').href = paper.driveUrl;
            document.getElementById('abstractModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('abstractModal').classList.add('hidden');
        }

        document.getElementById('searchInput').addEventListener('input', filterPapers);
        renderPapers(researchPapers);
    </script>
</body>
</html>
